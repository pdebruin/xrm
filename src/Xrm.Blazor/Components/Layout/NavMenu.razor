@using Xrm.Core.Models
@using Xrm.Core.Services
@inject IEntityService EntityService
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav
@implements IDisposable
@rendermode InteractiveServer

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="" @onclick="NavigateHome" @onclick:preventDefault>XRM</a>
    </div>
</div>

<button title="Navigation menu" class="navbar-toggler @(_menuOpen ? "open" : "")" @onclick="ToggleMenu"></button>

<div class="nav-scrollable @(_menuOpen ? "mobile-open" : "")">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <a class="nav-link" href="" @onclick="NavigateHome" @onclick:preventDefault>
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </a>
        </div>

        @if (_entities is not null)
        {
            var grouped = _entities.GroupBy(e => e.Domain ?? "").OrderBy(g => g.Min(e => e.SortOrder));
            var hasMultipleGroups = grouped.Count() > 1;
            @foreach (var group in grouped)
            {
                var groupKey = !string.IsNullOrEmpty(group.Key) ? group.Key : hasMultipleGroups ? "General" : "";
                @if (!string.IsNullOrEmpty(groupKey))
                {
                    var isCollapsed = _collapsedGroups.Contains(groupKey);
                    <h6 class="nav-heading px-3 mt-3 mb-1 text-uppercase" 
                        style="cursor:pointer;user-select:none;" 
                        @onclick="() => ToggleGroup(groupKey)">
                        <span>@(isCollapsed ? "▸" : "▾")</span> @groupKey
                    </h6>

                    @if (!isCollapsed)
                    {
                        @foreach (var entity in group)
                        {
                            <div class="nav-item px-3">
                                <NavLink class="nav-link" href="@($"records/{entity.Id}")">
                                    @(entity.DisplayName ?? entity.Name)
                                </NavLink>
                            </div>
                        }
                    }
                }
                else
                {
                    @foreach (var entity in group)
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="@($"records/{entity.Id}")">
                                @(entity.DisplayName ?? entity.Name)
                            </NavLink>
                        </div>
                    }
                }
            }
        }

        @if (CurrentUser.IsSystemAdmin)
        {
            <hr class="mx-3" />

            var settingsCollapsed = _collapsedGroups.Contains("__settings");
            var settingsKey = "__settings";
            <h6 class="nav-heading px-3 mt-1 mb-1 text-uppercase"
                style="cursor:pointer;user-select:none;"
                @onclick="() => ToggleGroup(settingsKey)">
                <span>@(settingsCollapsed ? "▸" : "▾")</span> Settings
            </h6>
            @if (!settingsCollapsed)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/entities">
                        <span class="bi bi-gear-fill-nav-menu" aria-hidden="true"></span> Entities
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/relationships">
                        <span class="bi bi-diagram-nav-menu" aria-hidden="true"></span> Relationships
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/users">
                        <span class="bi bi-lock-fill-nav-menu" aria-hidden="true"></span> Security
                    </NavLink>
                </div>
            }
        }
    </nav>
</div>

@code {
    private List<EntityDefinition>? _entities;
    private HashSet<string> _collapsedGroups = new();
    private bool _menuOpen;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        try
        {
            var all = await EntityService.GetAllAsync();
            _entities = all.Where(e => CurrentUser.CanRead(e.Domain)).ToList();
        }
        catch
        {
            _entities = new();
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _menuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    private void ToggleMenu() => _menuOpen = !_menuOpen;

    private void NavigateHome() => Nav.NavigateTo("/");

    private void ToggleGroup(string groupKey)
    {
        if (!_collapsedGroups.Remove(groupKey))
            _collapsedGroups.Add(groupKey);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}

