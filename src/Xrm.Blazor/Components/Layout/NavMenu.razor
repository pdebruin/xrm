@using Xrm.Core.Models
@using Xrm.Core.Services
@using Xrm.Core.Data
@using Microsoft.EntityFrameworkCore
@inject IEntityService EntityService
@inject ICurrentUser CurrentUser
@inject IDbContextFactory<XrmDbContext> DbFactory
@rendermode InteractiveServer

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">XRM</a>
        @if (CurrentUser.IsAuthenticated)
        {
            <div class="ms-auto user-chip" @onclick="() => _showUserPanel = !_showUserPanel">
                <span class="user-chip-name">@(CurrentUser.DisplayName ?? CurrentUser.Email)</span>
                @if (CurrentUser.IsSystemAdmin)
                {
                    <span class="badge bg-warning text-dark ms-1">Admin</span>
                }
            </div>
        }
    </div>
</div>

@if (_showUserPanel)
{
    <div class="user-panel">
        <div class="user-panel-header">
            <strong>@(CurrentUser.DisplayName ?? "User")</strong>
            <button class="btn-close btn-close-white btn-sm" @onclick="() => _showUserPanel = false"></button>
        </div>
        <div class="user-panel-body">
            <div class="mb-2"><small class="text-muted">Email</small><br/>@CurrentUser.Email</div>
            @if (_assignments.Count > 0)
            {
                <div class="mb-2">
                    <small class="text-muted">Roles</small>
                    @foreach (var a in _assignments)
                    {
                        <div>
                            <span class="badge bg-primary me-1">@a.Role</span>
                            <span class="text-muted">@(a.Domain ?? "All domains")</span>
                        </div>
                    }
                </div>
            }
            else if (!CurrentUser.IsSystemAdmin)
            {
                <div class="text-muted mb-2">No roles assigned</div>
            }
            <hr class="my-2" />
            <a href="authentication/logout" class="btn btn-sm btn-outline-light w-100">Sign out</a>
        </div>
    </div>
}

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        @if (_entities is not null)
        {
            var grouped = _entities.GroupBy(e => e.Domain ?? "").OrderBy(g => g.Min(e => e.SortOrder));
            var hasMultipleGroups = grouped.Count() > 1;
            @foreach (var group in grouped)
            {
                var groupKey = !string.IsNullOrEmpty(group.Key) ? group.Key : hasMultipleGroups ? "General" : "";
                @if (!string.IsNullOrEmpty(groupKey))
                {
                    var isCollapsed = _collapsedGroups.Contains(groupKey);
                    <h6 class="nav-heading px-3 mt-3 mb-1 text-uppercase" 
                        style="cursor:pointer;user-select:none;" 
                        @onclick="() => ToggleGroup(groupKey)">
                        <span>@(isCollapsed ? "▸" : "▾")</span> @groupKey
                    </h6>

                    @if (!isCollapsed)
                    {
                        @foreach (var entity in group)
                        {
                            <div class="nav-item px-3">
                                <NavLink class="nav-link" href="@($"records/{entity.Id}")">
                                    @(entity.DisplayName ?? entity.Name)
                                </NavLink>
                            </div>
                        }
                    }
                }
                else
                {
                    @foreach (var entity in group)
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="@($"records/{entity.Id}")">
                                @(entity.DisplayName ?? entity.Name)
                            </NavLink>
                        </div>
                    }
                }
            }
        }

        <hr class="mx-3" />

        @{
            var settingsCollapsed = _collapsedGroups.Contains("__settings");
            var settingsKey = "__settings";
        }
        <h6 class="nav-heading px-3 mt-1 mb-1 text-uppercase"
            style="cursor:pointer;user-select:none;"
            @onclick="() => ToggleGroup(settingsKey)">
            <span>@(settingsCollapsed ? "▸" : "▾")</span> Settings
        </h6>
        @if (!settingsCollapsed)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/entities">
                    <span class="bi bi-gear-fill-nav-menu" aria-hidden="true"></span> Entities
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/relationships">
                    <span class="bi bi-diagram-nav-menu" aria-hidden="true"></span> Relationships
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/users">
                    <span class="bi bi-lock-fill-nav-menu" aria-hidden="true"></span> Security
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private List<EntityDefinition>? _entities;
    private HashSet<string> _collapsedGroups = new();
    private bool _showUserPanel;
    private List<DomainAssignment> _assignments = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var all = await EntityService.GetAllAsync();
            _entities = all.Where(e => CurrentUser.CanRead(e.Domain)).ToList();
        }
        catch
        {
            _entities = new();
        }

        if (CurrentUser.IsAuthenticated && CurrentUser.Email is not null)
        {
            try
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                var email = CurrentUser.Email.ToLowerInvariant();
                _assignments = await db.Set<DomainAssignment>()
                    .Where(a => a.UserEmail == email && a.IsActive)
                    .ToListAsync();
            }
            catch { }
        }
    }

    private void ToggleGroup(string groupKey)
    {
        if (!_collapsedGroups.Remove(groupKey))
            _collapsedGroups.Add(groupKey);
    }
}

