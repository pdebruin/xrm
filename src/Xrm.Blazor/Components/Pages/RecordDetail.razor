@page "/records/{EntityId:guid}/new"
@page "/records/{EntityId:guid}/{RecordId:guid}"
@using System.Text.Json
@using Xrm.Core.Models
@using Xrm.Core.Services
@using Xrm.Blazor.Helpers
@inject IEntityService EntityService
@inject IRecordService RecordService
@inject IRelationshipService RelationshipService
@inject IAuditService AuditService
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>XRM</PageTitle>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
@if (_warning is not null)
{
    <div class="alert alert-warning">Saved — Warning: @_warning</div>
}

@if (_entityDef is null)
{
    <p>Loading...</p>
}
else
{
    <div class="detail-header">
        <button class="btn btn-link" @onclick="GoBack">← Back to @(_entityDef.PluralName ?? _entityDef.DisplayName)</button>
        <h3>
            @if (_isNew) { <span>New @(_entityDef.DisplayName ?? _entityDef.Name)</span> }
            else { <span>@(_entityDef.DisplayName ?? _entityDef.Name)</span> }
        </h3>
        @if (!_isNew)
        {
            <div class="ms-auto">
                <button class="btn btn-sm btn-outline-secondary" disabled="@(_prevRecordId is null)" @onclick="GoPrev">←</button>
                <button class="btn btn-sm btn-outline-secondary" disabled="@(_nextRecordId is null)" @onclick="GoNext">→</button>
            </div>
        }
    </div>

    @if (!_isNew && !_editing)
    {
        @* === READ MODE === *@
        <div class="detail-read">
            <div class="d-flex justify-content-end mb-2">
                @if (CurrentUser.CanWrite(_entityDef?.Domain))
                {
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => _editing = true">✎ Edit</button>
                }
            </div>
            <table class="table table-sm detail-table">
                <tbody>
                    @foreach (var field in _fields)
                    {
                        <tr>
                            <th class="text-muted field-label">@(field.DisplayName ?? field.Name)</th>
                            <td>@GetDisplayValue(field)</td>
                        </tr>
                    }
                    @foreach (var rel in _parentRelationships)
                    {
                        <tr>
                            <th class="text-muted field-label">@(rel.DisplayName ?? rel.Name)</th>
                            <td>
                                @if (Guid.TryParse(GetParentValue(rel.Id), out var pid))
                                {
                                    var label = _parentOptions.TryGetValue(rel.Id, out var opts)
                                        ? opts.FirstOrDefault(o => o.Id == pid)?.Label ?? pid.ToString()
                                        : pid.ToString();
                                    <a href="@($"records/{rel.ParentEntityId}/{pid}")" class="text-decoration-none">@label ↗</a>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        @* === EDIT MODE (also used for new records) === *@
        <div class="detail-form">
            @foreach (var field in _fields)
            {
                <div class="mb-3">
                    <label class="form-label">
                        @(field.DisplayName ?? field.Name)
                        @if (field.IsRequired) { <span class="text-danger">*</span> }
                    </label>
                    @switch (field.DataType)
                    {
                        case FieldDataType.AutoNumber:
                            <input type="text" class="form-control" value="@GetValue(field.Name)" 
                                   readonly placeholder="(auto-generated)" />
                            break;

                        case FieldDataType.Computed:
                            <input type="text" class="form-control" value="@DisplayFormatter.FormatValue(GetValue(field.Name), FieldDataType.Decimal)" 
                                   readonly placeholder="(computed)" />
                            break;

                        case FieldDataType.Boolean:
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" 
                                       checked="@GetBoolValue(field.Name)"
                                       @onchange="(e) => SetValue(field.Name, e.Value)" />
                            </div>
                            break;

                        case FieldDataType.Choice:
                            <select class="form-select" value="@GetValue(field.Name)" 
                                    @onchange="(e) => SetValue(field.Name, e.Value)">
                                <option value="">-- Select --</option>
                                @foreach (var opt in GetChoiceOptions(field))
                                {
                                    <option value="@opt">@opt</option>
                                }
                            </select>
                            break;

                        case FieldDataType.MultiChoice:
                            var mcSelected = GetMultiChoiceValues(field.Name);
                            @foreach (var opt in GetOptions(field))
                            {
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input"
                                           checked="@mcSelected.Contains(opt)"
                                           @onchange="(e) => ToggleMultiChoice(field.Name, opt, (bool)(e.Value ?? false))" />
                                    <label class="form-check-label">@opt</label>
                                </div>
                            }
                            break;

                        case FieldDataType.RichText:
                            <textarea class="form-control" rows="4" 
                                      value="@GetValue(field.Name)"
                                      @onchange="(e) => SetValue(field.Name, e.Value)"></textarea>
                            break;

                        case FieldDataType.Number:
                        case FieldDataType.Decimal:
                            <input type="number" class="form-control" 
                                   step="@(field.DataType == FieldDataType.Decimal ? "0.01" : "1")"
                                   value="@GetValue(field.Name)"
                                   @onchange="(e) => SetValue(field.Name, e.Value)" />
                            break;

                        case FieldDataType.Date:
                            <input type="date" class="form-control"
                                   value="@GetValue(field.Name)"
                                   @onchange="(e) => SetValue(field.Name, e.Value)" />
                            break;

                        case FieldDataType.DateTime:
                            <input type="datetime-local" class="form-control"
                                   value="@GetValue(field.Name)"
                                   @onchange="(e) => SetValue(field.Name, e.Value)" />
                            break;

                        default:
                            <input type="@GetInputType(field.DataType)" class="form-control"
                                   maxlength="@(field.MaxLength?.ToString() ?? "")"
                                   value="@GetValue(field.Name)"
                                   @onchange="(e) => SetValue(field.Name, e.Value)" />
                            break;
                    }
                </div>
            }

            @* Parent relationships as dropdowns *@
            @foreach (var rel in _parentRelationships)
            {
                <div class="mb-3">
                    <label class="form-label">@(rel.DisplayName ?? rel.Name)</label>
                    <div class="d-flex gap-2">
                        <select class="form-select" value="@GetParentValue(rel.Id)" 
                                @onchange="(e) => SetParentValue(rel.Id, e.Value?.ToString())">
                            <option value="">-- None --</option>
                            @if (_parentOptions.TryGetValue(rel.Id, out var options))
                            {
                                @foreach (var opt in options)
                                {
                                    <option value="@opt.Id">@opt.Label</option>
                                }
                            }
                        </select>
                        @if (Guid.TryParse(GetParentValue(rel.Id), out _))
                        {
                            <button class="btn btn-outline-secondary btn-sm" title="Go to parent"
                                    @onclick="() => NavigateToParent(rel)">↗</button>
                        }
                    </div>
                </div>
            }

            <div class="detail-actions">
                <button class="btn btn-primary" @onclick="Save" disabled="@_saving">
                    @(_saving ? "Saving..." : "Save")
                </button>
                @if (!_isNew)
                {
                    <button class="btn btn-outline-secondary" @onclick="CancelEdit">Cancel</button>
                }
                else
                {
                    <button class="btn btn-outline-secondary" @onclick="GoBack">Cancel</button>
                }
            </div>
        </div>
    }

    @* Child relationships — always visible *@
    @if (!_isNew && _childRelationships.Any())
    {
        <hr />
        @foreach (var rel in _childRelationships)
        {
            var section = _childSections.GetValueOrDefault(rel.Id);
            if (section is null) continue;

            <div class="child-section mb-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="mb-0">@(section.Entity.PluralName ?? section.Entity.DisplayName ?? section.Entity.Name)</h5>
                    @if (CurrentUser.CanWrite(section.Entity.Domain))
                    {
                        <button class="btn btn-sm btn-primary" @onclick="() => StartAddChild(rel.Id)">+ Add</button>
                    }
                </div>

                @if (section.Records.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead>
                                <tr>
                                    @foreach (var f in section.Fields)
                                    {
                                        <th>@(f.DisplayName ?? f.Name)</th>
                                    }
                                    <th style="width:100px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var rec in section.Records)
                                {
                                    <tr style="cursor:pointer" @onclick="() => OpenChildDetail(rel.ChildEntityId, rec.Id)">
                                        @foreach (var f in section.Fields)
                                        {
                                            <td>@GetChildCellValue(rec.DataJson, f.Name)</td>
                                        }
                                        <td class="text-end text-nowrap" @onclick:stopPropagation="true">
                                            @if (CurrentUser.CanWrite(section.Entity.Domain))
                                            {
                                                <button class="btn btn-sm btn-outline-primary me-1" title="Edit"
                                                        @onclick="() => StartEditChild(rel.Id, rec)">✎</button>
                                                <button class="btn btn-sm btn-outline-danger" title="Delete"
                                                        @onclick="() => DeleteChild(rel.Id, rec.Id)">✕</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">No records yet.</p>
                }

                @* Inline add/edit form *@
                @if (_editingChildRelId == rel.Id)
                {
                    <div class="card card-body bg-light mt-2">
                        <h6>@(_editingChildId is null ? "Add" : "Edit") @(section.Entity.DisplayName ?? section.Entity.Name)</h6>
                        @foreach (var f in section.Fields)
                        {
                            <div class="mb-2">
                                <label class="form-label form-label-sm">@(f.DisplayName ?? f.Name)</label>
                                @switch (f.DataType)
                                {
                                    case FieldDataType.Boolean:
                                        <div class="form-check">
                                            <input type="checkbox" class="form-check-input"
                                                   checked="@GetChildEditBool(f.Name)"
                                                   @onchange="(e) => SetChildEditValue(f.Name, e.Value)" />
                                        </div>
                                        break;

                                    case FieldDataType.Number:
                                    case FieldDataType.Decimal:
                                        <input type="number" class="form-control form-control-sm"
                                               step="@(f.DataType == FieldDataType.Decimal ? "0.01" : "1")"
                                               value="@GetChildEditValue(f.Name)"
                                               @onchange="(e) => SetChildEditValue(f.Name, e.Value)" />
                                        break;

                                    case FieldDataType.Choice:
                                        <select class="form-select form-select-sm" value="@GetChildEditValue(f.Name)"
                                                @onchange="(e) => SetChildEditValue(f.Name, e.Value)">
                                            <option value="">-- Select --</option>
                                            @foreach (var opt in GetOptions(f))
                                            {
                                                <option value="@opt">@opt</option>
                                            }
                                        </select>
                                        break;

                                    case FieldDataType.MultiChoice:
                                        var cmcSelected = GetChildMultiChoiceValues(f.Name);
                                        @foreach (var opt in GetOptions(f))
                                        {
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input"
                                                       checked="@cmcSelected.Contains(opt)"
                                                       @onchange="(e) => ToggleChildMultiChoice(f.Name, opt, (bool)(e.Value ?? false))" />
                                                <label class="form-check-label">@opt</label>
                                            </div>
                                        }
                                        break;

                                    default:
                                        <input type="text" class="form-control form-control-sm"
                                               value="@GetChildEditValue(f.Name)"
                                               @onchange="(e) => SetChildEditValue(f.Name, e.Value)" />
                                        break;
                                }
                            </div>
                        }
                        <div class="mt-2">
                            <button class="btn btn-sm btn-primary me-1" @onclick="() => SaveChild(rel.Id)">Save</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="CancelChildEdit">Cancel</button>
                        </div>
                        @if (_childEditError is not null)
                        {
                            <div class="alert alert-danger mt-2 py-1 px-2 small">@_childEditError</div>
                        }
                    </div>
                }
            </div>
        }
    }

    @if (!_isNew)
    {
        <div class="mt-4">
            <h5 class="mb-3">
                <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleHistory">
                    @(_showHistory ? "▾" : "▸") History
                </button>
            </h5>
            @if (_showHistory)
            {
                @if (_auditEntries.Count == 0)
                {
                    <p class="text-muted small">No history available.</p>
                }
                else
                {
                    <table class="table table-sm small">
                        <thead>
                            <tr>
                                <th>When</th>
                                <th>Action</th>
                                <th>User</th>
                                <th>Changes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in _auditEntries)
                            {
                                <tr>
                                    <td class="text-nowrap">@entry.Timestamp.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@entry.Action</td>
                                    <td>@entry.UserId</td>
                                    <td>
                                        @if (entry.Action == "Created")
                                        {
                                            <span class="text-muted">Record created</span>
                                        }
                                        else if (entry.Action == "Deleted")
                                        {
                                            <span class="text-muted">Record deleted</span>
                                        }
                                        else
                                        {
                                            @foreach (var change in GetAuditChanges(entry))
                                            {
                                                <div>
                                                    <strong>@GetFieldLabel(change.Field)</strong>:
                                                    <span class="text-danger text-decoration-line-through">@Truncate(change.OldValue)</span>
                                                    → <span class="text-success">@Truncate(change.NewValue)</span>
                                                </div>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
        </div>
    }
}

@code {
    [Parameter] public Guid EntityId { get; set; }
    [Parameter] public Guid? RecordId { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? QSort { get; set; }
    [SupplyParameterFromQuery(Name = "dir")] public string? QDir { get; set; }
    [SupplyParameterFromQuery(Name = "filter")] public string? QFilter { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? QPage { get; set; }

    private bool _isNew => RecordId is null;
    private bool _saving;
    private bool _editing;
    private bool _showHistory;
    private string? _error;
    private string? _warning;
    private EntityDefinition? _entityDef;
    private List<FieldDefinition> _fields = new();
    private Dictionary<string, object?> _data = new();
    private List<AuditEntry> _auditEntries = new();

    private List<RelationshipDefinition> _parentRelationships = new();
    private List<RelationshipDefinition> _childRelationships = new();
    private Dictionary<Guid, List<ParentOption>> _parentOptions = new();
    private Dictionary<Guid, string?> _parentValues = new();
    private Dictionary<Guid, string?> _originalParentValues = new();
    private Dictionary<Guid, Guid?> _parentLinkIds = new();
    private Dictionary<Guid, ChildSection> _childSections = new();

    // Child inline editing state
    private Guid? _editingChildRelId;
    private Guid? _editingChildId;
    private Dictionary<string, object?> _childEditData = new();
    private string? _childEditError;

    // Record navigation
    private Guid? _prevRecordId;
    private Guid? _nextRecordId;

    protected override async Task OnParametersSetAsync()
    {
        _error = null;
        _entityDef = await EntityService.GetByIdAsync(EntityId);
        _fields = _entityDef?.Fields?.OrderBy(f => f.SortOrder).ToList() ?? new();

        // Get relationships for this entity
        var (asParent, asChild) = await RelationshipService.GetForEntityAsync(EntityId);
        _parentRelationships = asChild.Where(r => r.RelationshipType == RelationshipType.OneToMany).ToList();
        _childRelationships = asParent.Where(r => r.RelationshipType == RelationshipType.OneToMany).ToList();

        // Load parent options
        foreach (var rel in _parentRelationships)
        {
            var parentEntity = await EntityService.GetByIdAsync(rel.ParentEntityId);
            var displayField = GetPrimaryFieldName(parentEntity);
            var parentRecords = await RecordService.GetAllAsync(rel.ParentEntityId, 1, 100);

            _parentOptions[rel.Id] = parentRecords.Records.Select(r =>
            {
                var d = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(r.DataJson) ?? new();
                var label = d.TryGetValue(displayField, out var v) ? v.ToString() : r.Id.ToString();
                return new ParentOption { Id = r.Id, Label = label };
            }).ToList();
        }

        if (!_isNew)
        {
            var record = await RecordService.GetByIdAsync(EntityId, RecordId!.Value);
            if (record is not null)
            {
                _data = JsonSerializer.Deserialize<Dictionary<string, object?>>(record.DataJson) ?? new();
            }

            // Load links
            var links = await RecordService.GetLinksAsync(EntityId, RecordId!.Value);

            foreach (var rel in _parentRelationships)
            {
                var link = links.FirstOrDefault(l => l.RelationshipId == rel.Id && l.Direction == "incoming");
                _parentValues[rel.Id] = link?.ParentRecordId.ToString();
                _originalParentValues[rel.Id] = link?.ParentRecordId.ToString();
                _parentLinkIds[rel.Id] = link?.Id;
            }

            foreach (var rel in _childRelationships)
            {
                await LoadChildSection(rel);
            }

            // Load prev/next for record navigation
            await LoadRecordNavigation();
        }
    }

    private async Task LoadRecordNavigation()
    {
        _prevRecordId = null;
        _nextRecordId = null;
        if (RecordId is null) return;

        // Load all record IDs with same sort/filter context
        var result = await RecordService.GetAllAsync(EntityId, QPage ?? 1, 1000,
            string.IsNullOrEmpty(QSort) ? null : QSort,
            string.IsNullOrEmpty(QDir) ? "asc" : QDir,
            string.IsNullOrEmpty(QFilter) ? null : QFilter);

        var ids = result.Records.Select(r => r.Id).ToList();
        var idx = ids.IndexOf(RecordId.Value);
        if (idx > 0) _prevRecordId = ids[idx - 1];
        if (idx >= 0 && idx < ids.Count - 1) _nextRecordId = ids[idx + 1];
    }

    private string BuildNavUrl(Guid recordId)
    {
        var qs = $"?sort={Uri.EscapeDataString(QSort ?? "")}&dir={QDir ?? "asc"}&filter={Uri.EscapeDataString(QFilter ?? "")}&page={QPage ?? 1}";
        return $"records/{EntityId}/{recordId}{qs}";
    }

    private string GetValue(string fieldName)
    {
        if (_data.TryGetValue(fieldName, out var val) && val is not null)
        {
            if (val is JsonElement je) return je.ValueKind == JsonValueKind.Null ? "" : je.ToString();
            return val.ToString() ?? "";
        }
        return "";
    }

    private bool GetBoolValue(string fieldName)
    {
        var v = GetValue(fieldName);
        return v.Equals("true", StringComparison.OrdinalIgnoreCase) || v == "True";
    }

    private void SetValue(string fieldName, object? value) => _data[fieldName] = value;

    private HashSet<string> GetMultiChoiceValues(string fieldName)
    {
        if (!_data.TryGetValue(fieldName, out var val) || val is null) return new();
        if (val is JsonElement je)
        {
            if (je.ValueKind == JsonValueKind.Array)
                return je.EnumerateArray().Select(e => e.GetString() ?? "").Where(s => s != "").ToHashSet();
            if (je.ValueKind == JsonValueKind.String)
            {
                var s = je.GetString();
                return string.IsNullOrEmpty(s) ? new() : new HashSet<string> { s };
            }
        }
        if (val is List<object?> list)
            return list.Select(o => o?.ToString() ?? "").Where(s => s != "").ToHashSet();
        return new();
    }

    private void ToggleMultiChoice(string fieldName, string option, bool selected)
    {
        var values = GetMultiChoiceValues(fieldName);
        if (selected) values.Add(option); else values.Remove(option);
        _data[fieldName] = values.ToList();
    }

    private string GetDisplayValue(FieldDefinition field)
    {
        if (field.DataType == FieldDataType.MultiChoice)
        {
            var values = GetMultiChoiceValues(field.Name);
            return values.Count > 0 ? string.Join(", ", values) : "—";
        }
        var raw = GetValue(field.Name);
        if (string.IsNullOrEmpty(raw)) return "—";
        return DisplayFormatter.FormatValue(raw, field.DataType);
    }

    private string GetParentValue(Guid relId) => _parentValues.TryGetValue(relId, out var v) ? v ?? "" : "";
    private void SetParentValue(Guid relId, string? value) => _parentValues[relId] = value;

    private List<string> GetOptions(FieldDefinition field)
    {
        if (string.IsNullOrEmpty(field.OptionsJson)) return new();
        try
        {
            return JsonSerializer.Deserialize<List<string>>(field.OptionsJson) ?? new();
        }
        catch (JsonException)
        {
            return new();
        }
    }

    private List<string> GetChoiceOptions(FieldDefinition field)
    {
        var all = GetOptions(field);
        if (string.IsNullOrEmpty(field.TransitionsJson) || _isNew) return all;

        var current = GetValue(field.Name);
        if (string.IsNullOrEmpty(current)) return all;

        try
        {
            var transitions = JsonSerializer.Deserialize<Dictionary<string, List<string>>>(field.TransitionsJson);
            if (transitions is not null && transitions.TryGetValue(current, out var allowed))
                return allowed.Where(a => all.Contains(a)).Prepend(current).Distinct().ToList();
            // Terminal state — only show current value
            if (transitions is not null && transitions.Count > 0)
                return new List<string> { current };
        }
        catch (JsonException) { }
        return all;
    }

    private string GetInputType(FieldDataType type) => type switch
    {
        FieldDataType.Email => "email",
        FieldDataType.Phone => "tel",
        FieldDataType.Url => "url",
        _ => "text"
    };

    private async Task Save()
    {
        _saving = true;
        _error = null;
        _warning = null;
        try
        {
            var json = JsonSerializer.Serialize(_data);

            if (_isNew)
            {
                var result = await RecordService.CreateAsync(EntityId, json);
                if (result.HasWarnings)
                    _warning = string.Join("; ", result.Warnings!);
                foreach (var (relId, parentId) in _parentValues)
                {
                    if (Guid.TryParse(parentId, out var pid))
                    {
                        await RecordService.CreateLinkAsync(pid, relId, result.Record!.Id);
                    }
                }
                Nav.NavigateTo($"records/{EntityId}");
            }
            else
            {
                var result = await RecordService.UpdateAsync(EntityId, RecordId!.Value, json);
                if (result.HasWarnings)
                    _warning = string.Join("; ", result.Warnings!);
                await SaveParentLinks();
                // Reload child sections (lifecycle hooks may have created/modified children)
                foreach (var rel in _childRelationships)
                    await LoadChildSection(rel);
                // Reload history if visible
                if (_showHistory)
                    _auditEntries = await AuditService.GetHistoryAsync(RecordId.Value);
                _editing = false;
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }

    private async Task SaveParentLinks()
    {
        foreach (var rel in _parentRelationships)
        {
            var oldVal = _originalParentValues.GetValueOrDefault(rel.Id);
            var newVal = _parentValues.GetValueOrDefault(rel.Id);

            if (oldVal == newVal) continue;

            // Remove existing link if there was one
            if (_parentLinkIds.TryGetValue(rel.Id, out var linkId) && linkId.HasValue)
            {
                await RecordService.DeleteLinkAsync(linkId.Value);
            }

            // Create new link if a parent is selected
            if (Guid.TryParse(newVal, out var newParentId))
            {
                await RecordService.CreateLinkAsync(newParentId, rel.Id, RecordId!.Value);
            }
        }
    }

    private void GoBack() => Nav.NavigateTo($"records/{EntityId}");
    private void GoPrev() { if (_prevRecordId is not null) Nav.NavigateTo(BuildNavUrl(_prevRecordId.Value)); }
    private void GoNext() { if (_nextRecordId is not null) Nav.NavigateTo(BuildNavUrl(_nextRecordId.Value)); }
    private void CancelEdit() => _editing = false;

    private void NavigateToParent(RelationshipDefinition rel)
    {
        if (_parentValues.TryGetValue(rel.Id, out var parentId) && Guid.TryParse(parentId, out var pid))
        {
            Nav.NavigateTo($"records/{rel.ParentEntityId}/{pid}");
        }
    }

    private void OpenChildDetail(Guid childEntityId, Guid childRecordId)
    {
        Nav.NavigateTo($"records/{childEntityId}/{childRecordId}");
    }

    private string GetChildCellValue(string dataJson, string fieldName)
    {
        try
        {
            using var doc = JsonDocument.Parse(dataJson);
            if (doc.RootElement.TryGetProperty(fieldName, out var val))
                return val.ValueKind == JsonValueKind.Null ? "" : val.ToString();
        }
        catch { }
        return "";
    }

    private async Task LoadChildSection(RelationshipDefinition rel)
    {
        var entity = await EntityService.GetByIdAsync(rel.ChildEntityId);
        var fields = entity?.Fields?.OrderBy(f => f.SortOrder).ToList() ?? new();
        var links = await RecordService.GetLinksAsync(EntityId, RecordId!.Value);
        var childLinks = links.Where(l => l.RelationshipId == rel.Id && l.Direction == "outgoing").ToList();
        var records = new List<Record>();
        foreach (var cl in childLinks)
        {
            var rec = await RecordService.GetByIdAsync(rel.ChildEntityId, cl.ChildRecordId);
            if (rec is not null) records.Add(rec);
        }
        _childSections[rel.Id] = new ChildSection
        {
            Entity = entity!,
            Fields = fields,
            Records = records
        };
    }

    private void StartAddChild(Guid relId)
    {
        _editingChildRelId = relId;
        _editingChildId = null;
        _childEditData = new();
        _childEditError = null;
    }

    private void StartEditChild(Guid relId, Record rec)
    {
        _editingChildRelId = relId;
        _editingChildId = rec.Id;
        _childEditData = JsonSerializer.Deserialize<Dictionary<string, object?>>(rec.DataJson) ?? new();
        _childEditError = null;
    }

    private void CancelChildEdit()
    {
        _editingChildRelId = null;
        _editingChildId = null;
        _childEditData = new();
        _childEditError = null;
    }

    private string GetChildEditValue(string fieldName)
    {
        if (_childEditData.TryGetValue(fieldName, out var val) && val is not null)
        {
            if (val is JsonElement je) return je.ValueKind == JsonValueKind.Null ? "" : je.ToString();
            return val.ToString() ?? "";
        }
        return "";
    }

    private bool GetChildEditBool(string fieldName) =>
        GetChildEditValue(fieldName).Equals("true", StringComparison.OrdinalIgnoreCase);

    private void SetChildEditValue(string fieldName, object? value) => _childEditData[fieldName] = value;

    private HashSet<string> GetChildMultiChoiceValues(string fieldName)
    {
        if (!_childEditData.TryGetValue(fieldName, out var val) || val is null) return new();
        if (val is JsonElement je)
        {
            if (je.ValueKind == JsonValueKind.Array)
                return je.EnumerateArray().Select(e => e.GetString() ?? "").Where(s => s != "").ToHashSet();
            if (je.ValueKind == JsonValueKind.String)
            {
                var s = je.GetString();
                return string.IsNullOrEmpty(s) ? new() : new HashSet<string> { s };
            }
        }
        if (val is List<object?> list)
            return list.Select(o => o?.ToString() ?? "").Where(s => s != "").ToHashSet();
        return new();
    }

    private void ToggleChildMultiChoice(string fieldName, string option, bool selected)
    {
        var values = GetChildMultiChoiceValues(fieldName);
        if (selected) values.Add(option); else values.Remove(option);
        _childEditData[fieldName] = values.ToList();
    }

    private async Task SaveChild(Guid relId)
    {
        _childEditError = null;
        try
        {
            var rel = _childRelationships.First(r => r.Id == relId);
            var json = JsonSerializer.Serialize(_childEditData);

            if (_editingChildId is null)
            {
                // Create new child and link to parent
                var createResult = await RecordService.CreateAsync(rel.ChildEntityId, json);
                await RecordService.CreateLinkAsync(RecordId!.Value, relId, createResult.Record!.Id);
            }
            else
            {
                await RecordService.UpdateAsync(rel.ChildEntityId, _editingChildId.Value, json);
            }

            CancelChildEdit();
            await LoadChildSection(rel);
        }
        catch (Exception ex) { _childEditError = ex.Message; }
    }

    private async Task DeleteChild(Guid relId, Guid childRecordId)
    {
        try
        {
            var rel = _childRelationships.First(r => r.Id == relId);
            // Delete the link first, then the record
            var links = await RecordService.GetLinksAsync(EntityId, RecordId!.Value);
            var link = links.FirstOrDefault(l => l.RelationshipId == relId && l.ChildRecordId == childRecordId);
            if (link is not null) await RecordService.DeleteLinkAsync(link.Id);
            await RecordService.DeleteAsync(rel.ChildEntityId, childRecordId);
            await LoadChildSection(rel);
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private static string GetPrimaryFieldName(EntityDefinition? entity)
    {
        if (entity is null) return "Name";
        if (entity.PrimaryFieldId is not null)
        {
            var pf = entity.Fields?.FirstOrDefault(f => f.Id == entity.PrimaryFieldId);
            if (pf is not null) return pf.Name;
        }
        return entity.Fields?.OrderBy(f => f.SortOrder).FirstOrDefault()?.Name ?? "Name";
    }

    private class ParentOption { public Guid Id { get; set; } public string Label { get; set; } = ""; }
    private class ChildSection
    {
        public EntityDefinition Entity { get; set; } = null!;
        public List<FieldDefinition> Fields { get; set; } = new();
        public List<Record> Records { get; set; } = new();
    }

    private async Task ToggleHistory()
    {
        _showHistory = !_showHistory;
        if (_showHistory && RecordId.HasValue)
        {
            _auditEntries = await AuditService.GetHistoryAsync(RecordId.Value);
        }
    }

    private record AuditChange(string Field, string OldValue, string NewValue);

    private List<AuditChange> GetAuditChanges(AuditEntry entry)
    {
        if (entry.OldDataJson is null || entry.NewDataJson is null) return new();

        try
        {
            var oldData = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(entry.OldDataJson) ?? new();
            var newData = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(entry.NewDataJson) ?? new();
            var changes = new List<AuditChange>();
            foreach (var (key, newVal) in newData)
            {
                var newStr = FormatJsonValue(newVal);
                var oldStr = oldData.TryGetValue(key, out var oldVal) ? FormatJsonValue(oldVal) : "";
                if (oldStr != newStr)
                    changes.Add(new AuditChange(key, oldStr, newStr));
            }
            return changes;
        }
        catch { return new(); }
    }

    private static string FormatJsonValue(JsonElement el) => el.ValueKind switch
    {
        JsonValueKind.Null => "",
        JsonValueKind.Array => string.Join(", ", el.EnumerateArray().Select(e => e.ToString())),
        _ => el.ToString()
    };

    private string GetFieldLabel(string fieldName)
    {
        var field = _fields.FirstOrDefault(f => f.Name == fieldName);
        return field?.DisplayName ?? fieldName;
    }

    private static string Truncate(string value, int max = 60)
        => string.IsNullOrEmpty(value) ? "(empty)" : value.Length > max ? value[..max] + "…" : value;
}
