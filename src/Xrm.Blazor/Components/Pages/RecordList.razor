@page "/records/{EntityId:guid}"
@using System.Text.Json
@using Xrm.Core.Models
@using Xrm.Core.Services
@using Xrm.Blazor.Helpers
@inject IEntityService EntityService
@inject IRecordService RecordService
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>XRM</PageTitle>

@if (_entityDef is null)
{
    <p>Loading...</p>
}
else
{
    <div class="master-header">
        <h2>@(_entityDef.PluralName ?? _entityDef.DisplayName ?? _entityDef.Name)</h2>
        @if (_canWrite)
        {
            <button class="btn btn-primary btn-sm" @onclick="CreateNew">+ New</button>
        }
    </div>

    @if (_savedViews.Count > 0)
    {
        <div class="master-views mb-2">
            <select class="form-select form-select-sm d-inline-block w-auto" @onchange="OnViewChanged">
                <option value="">All</option>
                @foreach (var view in _savedViews)
                {
                    <option value="@view.Name" selected="@(_activeViewName == view.Name)">@view.Name</option>
                }
            </select>
        </div>
    }

    <div class="master-toolbar">
        <input type="text" class="form-control form-control-sm" placeholder="Filter..." 
               @bind="_filterText" @bind:event="oninput" @bind:after="LoadRecords" />
        <select class="form-select form-select-sm w-auto ms-2" @onchange="OnStatusChanged">
            <option value="active" selected="@(_statusFilter == "active")">Active</option>
            <option value="all" selected="@(_statusFilter == "all")">All</option>
            <option value="inactive" selected="@(_statusFilter == "inactive")">Deactivated</option>
        </select>
    </div>

    <div class="master-grid">
        <table class="table table-hover table-sm">
            <thead>
                <tr>
                    <th class="col-check">
                        <input type="checkbox" @onchange="ToggleSelectAll" />
                    </th>
                    @foreach (var field in _fields)
                    {
                        <th class="sortable" @onclick="() => SortBy(field.Name)">
                            @(field.DisplayName ?? field.Name)
                            @if (_sortField == field.Name)
                            {
                                <span>@(_sortDir == "asc" ? "▲" : "▼")</span>
                            }
                        </th>
                    }
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_records is not null)
                {
                    @foreach (var record in _records)
                    {
                        var data = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(record.DataJson) ?? new();
                        <tr class="@(_selected.Contains(record.Id) ? "table-active" : "")" @onclick="() => OpenDetail(record.Id)">
                            <td class="col-check" @onclick:stopPropagation="true">
                                <input type="checkbox" checked="@_selected.Contains(record.Id)" 
                                       @onchange="(e) => ToggleSelect(record.Id, (bool)(e.Value ?? false))" />
                            </td>
                            @foreach (var field in _fields)
                            {
                                <td data-label="@(field.DisplayName ?? field.Name)">@GetDisplayValue(data, field)</td>
                            }
                            <td class="text-end text-nowrap">
                                @if (_canWrite)
                                {
                                    @if (record.IsActive)
                                    {
                                        <button class="btn btn-link btn-sm text-danger" title="Deactivate" @onclick:stopPropagation="true" @onclick="() => DeactivateRecord(record.Id)">✕</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-link btn-sm text-success" title="Reactivate" @onclick:stopPropagation="true" @onclick="() => ReactivateRecord(record.Id)">↺</button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="master-footer">
        <span>@_total records</span>
        @if (_selected.Count > 0 && _canWrite)
        {
            <span class="ms-3">@_selected.Count selected</span>
            <button class="btn btn-outline-danger btn-sm ms-2" @onclick="DeactivateSelected">Deactivate Selected</button>
        }
        <div class="ms-auto">
            <button class="btn btn-sm btn-outline-secondary" disabled="@(_page <= 1)" @onclick="PrevPage">← Prev</button>
            <span class="mx-2">Page @_page</span>
            <button class="btn btn-sm btn-outline-secondary" disabled="@(_records?.Count < _pageSize)" @onclick="NextPage">Next →</button>
        </div>
    </div>
}

@code {
    [Parameter] public Guid EntityId { get; set; }

    private EntityDefinition? _entityDef;
    private List<FieldDefinition> _fields = new();
    private List<Record>? _records;
    private int _total;
    private int _page = 1;
    private int _pageSize = 25;
    private string _sortField = "";
    private string _sortDir = "asc";
    private string _filterText = "";
    private HashSet<Guid> _selected = new();
    private bool _canWrite;
    private List<SavedView> _savedViews = new();
    private string _activeViewName = "";
    private string _statusFilter = "active";

    protected override async Task OnParametersSetAsync()
    {
        _page = 1;
        _selected.Clear();
        _activeViewName = "";
        _entityDef = await EntityService.GetByIdAsync(EntityId);
        _fields = _entityDef?.Fields?.ToList() ?? new();
        _canWrite = CurrentUser.CanWrite(_entityDef?.Domain);
        _savedViews = ParseSavedViews(_entityDef?.SavedViewsJson);
        await LoadRecords();
    }

    private async Task LoadRecords()
    {
        var viewFilters = GetActiveViewFilters();
        bool? isActive = _statusFilter switch { "active" => true, "inactive" => false, _ => null };
        var result = await RecordService.GetAllAsync(EntityId, _page, _pageSize, _sortField, _sortDir, _filterText, viewFilters, isActive);
        _records = result.Records;
        _total = result.Total;
    }

    private List<ViewFilter>? GetActiveViewFilters()
    {
        if (string.IsNullOrEmpty(_activeViewName)) return null;
        var view = _savedViews.FirstOrDefault(v => v.Name == _activeViewName);
        if (view is null) return null;

        // Resolve tokens in filter values
        return view.Filters.Select(f => new ViewFilter
        {
            Field = f.Field,
            Operator = f.Operator,
            Value = ResolveTokens(f.Value)
        }).ToList();
    }

    private string ResolveTokens(string value)
    {
        if (value.Contains("{{currentUser}}", StringComparison.OrdinalIgnoreCase))
            return value.Replace("{{currentUser}}", CurrentUser.Email ?? "", StringComparison.OrdinalIgnoreCase);
        return value;
    }

    private static List<SavedView> ParseSavedViews(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return new();
        try
        {
            return JsonSerializer.Deserialize<List<SavedView>>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
        }
        catch { return new(); }
    }

    private async Task OnViewChanged(ChangeEventArgs e)
    {
        _activeViewName = e.Value?.ToString() ?? "";
        _page = 1;

        // Apply view's default sort if present
        var view = _savedViews.FirstOrDefault(v => v.Name == _activeViewName);
        if (view?.SortField is not null)
        {
            _sortField = view.SortField;
            _sortDir = view.SortDir ?? "asc";
        }

        await LoadRecords();
    }

    private async Task SortBy(string field)
    {
        if (_sortField == field)
            _sortDir = _sortDir == "asc" ? "desc" : "asc";
        else
        {
            _sortField = field;
            _sortDir = "asc";
        }
        await LoadRecords();
    }

    private void OpenDetail(Guid id)
    {
        var qs = $"?sort={Uri.EscapeDataString(_sortField ?? "")}&dir={_sortDir}&filter={Uri.EscapeDataString(_filterText ?? "")}&page={_page}";
        if (!string.IsNullOrEmpty(_activeViewName))
            qs += $"&view={Uri.EscapeDataString(_activeViewName)}";
        Nav.NavigateTo($"records/{EntityId}/{id}{qs}");
    }
    private void CreateNew() => Nav.NavigateTo($"records/{EntityId}/new");

    private void ToggleSelect(Guid id, bool selected)
    {
        if (selected) _selected.Add(id); else _selected.Remove(id);
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        if ((bool)(e.Value ?? false))
            _selected = _records?.Select(r => r.Id).ToHashSet() ?? new();
        else
            _selected.Clear();
    }

    private async Task DeactivateRecord(Guid id)
    {
        await RecordService.DeleteAsync(EntityId, id);
        await LoadRecords();
    }

    private async Task ReactivateRecord(Guid id)
    {
        await RecordService.ReactivateAsync(EntityId, id);
        await LoadRecords();
    }

    private async Task DeactivateSelected()
    {
        foreach (var id in _selected)
            await RecordService.DeleteAsync(EntityId, id);
        _selected.Clear();
        await LoadRecords();
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        _statusFilter = e.Value?.ToString() ?? "active";
        _page = 1;
        _selected.Clear();
        await LoadRecords();
    }

    private async Task PrevPage() { _page--; await LoadRecords(); }
    private async Task NextPage() { _page++; await LoadRecords(); }

    private string GetDisplayValue(Dictionary<string, JsonElement> data, FieldDefinition field)
    {
        if (!data.TryGetValue(field.Name, out var val)) return "";
        if (val.ValueKind == JsonValueKind.Null) return "";
        return DisplayFormatter.FormatValue(val.ToString(), field.DataType);
    }
}
