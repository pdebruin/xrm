@page "/admin/relationships"
@using Xrm.Core.Models
@using Xrm.Core.Services
@inject IEntityService EntityService
@inject IRelationshipService RelationshipService
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>XRM</PageTitle>

<div class="detail-header">
    <button class="btn btn-link" @onclick="GoBack">← Back to Entities</button>
    <h3>Relationships</h3>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

<div class="admin-header">
    <span></span>
    <button class="btn btn-primary btn-sm" @onclick="StartCreate">+ New Relationship</button>
</div>

@if (_relationships is null)
{
    <p>Loading...</p>
}
else if (_relationships.Count == 0)
{
    <p class="text-muted">No relationships defined yet. Create one to link entities together.</p>
}
else
{
    <div class="mb-2">
        <input type="text" class="form-control form-control-sm" style="max-width:300px;" placeholder="Filter relationships..." @bind="_filter" @bind:event="oninput" />
    </div>

    <table class="table table-sm table-hover">
        <thead>
            <tr>
                <th style="cursor:pointer;" @onclick='() => SetSort("name")'>Name @SortIndicator("name")</th>
                <th style="cursor:pointer;" @onclick='() => SetSort("parent")'>Parent Entity @SortIndicator("parent")</th>
                <th style="cursor:pointer;" @onclick='() => SetSort("child")'>Child Entity @SortIndicator("child")</th>
                <th>Type</th>
                <th>On Delete</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var rel in FilteredRelationships)
            {
                <tr>
                    <td>@(rel.DisplayName ?? rel.Name)</td>
                    <td>@(rel.ParentEntity?.DisplayName ?? rel.ParentEntity?.Name ?? "—")</td>
                    <td>@(rel.ChildEntity?.DisplayName ?? rel.ChildEntity?.Name ?? "—")</td>
                    <td><span class="badge bg-info">@rel.RelationshipType</span></td>
                    <td><span class="badge bg-warning text-dark">@rel.CascadeBehavior</span></td>
                    <td>
                        <button class="btn btn-outline-primary btn-sm me-1" @onclick="() => StartEdit(rel)">Edit</button>
                        <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteRel(rel.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (_showModal)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_editingId is null ? "New Relationship" : "Edit Relationship")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Name (identifier)</label>
                        <input class="form-control" @bind="_form.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Display Name</label>
                        <input class="form-control" @bind="_form.DisplayName" placeholder="e.g. Company → Contacts" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Parent Entity ("one" side)</label>
                        <select class="form-select" @bind="_form.ParentEntityId">
                            <option value="">-- Select --</option>
                            @if (_entities is not null)
                            {
                                @foreach (var e in _entities)
                                {
                                    <option value="@e.Id">@(e.DisplayName ?? e.Name)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Child Entity ("many" side)</label>
                        <select class="form-select" @bind="_form.ChildEntityId">
                            <option value="">-- Select --</option>
                            @if (_entities is not null)
                            {
                                @foreach (var e in _entities)
                                {
                                    <option value="@e.Id">@(e.DisplayName ?? e.Name)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Relationship Type</label>
                        <select class="form-select" @bind="_form.RelationshipType">
                            <option value="@RelationshipType.OneToMany">OneToMany</option>
                        </select>
                        <small class="text-muted">ManyToMany support planned for a future release.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Cascade on Delete</label>
                        <select class="form-select" @bind="_form.CascadeBehavior">
                            <option value="@CascadeBehavior.None">None</option>
                            <option value="@CascadeBehavior.RemoveLink">RemoveLink</option>
                        </select>
                        <small class="text-muted">Cascade delete planned for a future release.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveRel">Save</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@code {
    private List<RelationshipDefinition>? _relationships;
    private List<EntityDefinition>? _entities;
    private bool _showModal;
    private Guid? _editingId;
    private RelForm _form = new();
    private string? _error;
    private string _filter = "";
    private string _sortColumn = "name";
    private bool _sortAsc = true;

    private IEnumerable<RelationshipDefinition> FilteredRelationships
    {
        get
        {
            var q = (_relationships ?? new()).AsEnumerable();
            if (!string.IsNullOrWhiteSpace(_filter))
            {
                var f = _filter.Trim();
                q = q.Where(r =>
                    (r.Name?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (r.DisplayName?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (r.ParentEntity?.Name?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (r.ChildEntity?.Name?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false));
            }
            q = _sortColumn switch
            {
                "parent" => _sortAsc ? q.OrderBy(r => r.ParentEntity?.Name) : q.OrderByDescending(r => r.ParentEntity?.Name),
                "child" => _sortAsc ? q.OrderBy(r => r.ChildEntity?.Name) : q.OrderByDescending(r => r.ChildEntity?.Name),
                _ => _sortAsc ? q.OrderBy(r => r.DisplayName ?? r.Name) : q.OrderByDescending(r => r.DisplayName ?? r.Name),
            };
            return q;
        }
    }

    private void SetSort(string column)
    {
        if (_sortColumn == column) _sortAsc = !_sortAsc;
        else { _sortColumn = column; _sortAsc = true; }
    }

    private string SortIndicator(string column) =>
        _sortColumn == column ? (_sortAsc ? "▲" : "▼") : "";

    protected override async Task OnInitializedAsync()
    {
        _entities = await EntityService.GetAllAsync();
        await LoadRelationships();
    }

    private async Task LoadRelationships()
    {
        _error = null;
        try { _relationships = await RelationshipService.GetAllAsync(); }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void StartCreate()
    {
        _editingId = null;
        _form = new RelForm();
        _showModal = true;
    }

    private void StartEdit(RelationshipDefinition rel)
    {
        _editingId = rel.Id;
        _form = new RelForm
        {
            Name = rel.Name,
            DisplayName = rel.DisplayName ?? "",
            ParentEntityId = rel.ParentEntityId.ToString(),
            ChildEntityId = rel.ChildEntityId.ToString(),
            RelationshipType = rel.RelationshipType,
            CascadeBehavior = rel.CascadeBehavior
        };
        _showModal = true;
    }

    private async Task SaveRel()
    {
        _error = null;
        if (!Guid.TryParse(_form.ParentEntityId, out var parentId) ||
            !Guid.TryParse(_form.ChildEntityId, out var childId))
        {
            _error = "Please select both source and target entities.";
            return;
        }

        try
        {
            var rel = new RelationshipDefinition
            {
                Id = _editingId ?? Guid.Empty,
                Name = _form.Name,
                DisplayName = string.IsNullOrWhiteSpace(_form.DisplayName) ? null : _form.DisplayName,
                ParentEntityId = parentId,
                ChildEntityId = childId,
                RelationshipType = _form.RelationshipType,
                CascadeBehavior = _form.CascadeBehavior
            };

            if (_editingId is not null)
            {
                await RelationshipService.UpdateAsync(_editingId.Value, rel);
            }
            else
            {
                await RelationshipService.CreateAsync(rel);
            }

            CloseModal();
            await LoadRelationships();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task DeleteRel(Guid id)
    {
        _error = null;
        try
        {
            await RelationshipService.DeleteAsync(id);
            await LoadRelationships();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void CloseModal()
    {
        _showModal = false;
        _editingId = null;
        _form = new();
    }

    private void GoBack() => Nav.NavigateTo("admin/entities");

    private class RelForm
    {
        public string Name { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public string ParentEntityId { get; set; } = "";
        public string ChildEntityId { get; set; } = "";
        public RelationshipType RelationshipType { get; set; } = RelationshipType.OneToMany;
        public CascadeBehavior CascadeBehavior { get; set; } = CascadeBehavior.None;
    }
}
