@page "/admin/entities"
@using Xrm.Core.Models
@using Xrm.Core.Services
@inject IEntityService EntityService
@inject ICurrentUser CurrentUser
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>XRM</PageTitle>

@if (!CurrentUser.IsSystemAdmin)
{
    <div class="alert alert-danger">Access denied. SystemAdmin role required.</div>
    return;
}

<div class="admin-header">
    <h2>Schema Designer</h2>
    <button class="btn btn-primary btn-sm" @onclick="() => _showCreate = true">+ New Entity</button>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_entities is null)
{
    <p>Loading...</p>
}
else
{
    <div class="mb-2">
        <input type="text" class="form-control form-control-sm" style="max-width:300px;" placeholder="Filter entities..." @bind="_filter" @bind:event="oninput" />
    </div>

    <table class="table table-sm table-hover">
        <thead>
            <tr>
                <th style="cursor:pointer;" @onclick='() => SetSort("name")'>Name @SortIndicator("name")</th>
                <th style="cursor:pointer;" @onclick='() => SetSort("domain")'>Domain @SortIndicator("domain")</th>
                <th>Fields</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entity in FilteredEntities)
            {
                <tr>
                    <td>
                        @(entity.DisplayName ?? entity.Name)
                        <br/><small class="text-muted">@entity.Name</small>
                    </td>
                    <td>@(entity.Domain ?? "—")</td>
                    <td>@(entity.Fields?.Count ?? 0)</td>
                    <td class="text-end">
                        @if (entity.IsHomeEntity)
                        {
                            <span class="badge bg-success me-2">Home</span>
                        }
                        <a href="@($"admin/entities/{entity.Id}/fields")" class="btn btn-outline-secondary btn-sm me-1">Fields</a>
                        <button class="btn btn-outline-primary btn-sm me-1" @onclick="() => EditEntity(entity)">Edit</button>
                        <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteEntity(entity.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <hr />
    <a href="admin/relationships" class="btn btn-outline-secondary">Manage Relationships</a>
}

@if (_showCreate || _editingEntity is not null)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_editingEntity is null ? "New Entity" : "Edit Entity")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Name (identifier)</label>
                        <input class="form-control" @bind="_form.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Display Name</label>
                        <input class="form-control" @bind="_form.DisplayName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Plural Name</label>
                        <input class="form-control" @bind="_form.PluralName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" @bind="_form.Description"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Domain (grouping)</label>
                        <input class="form-control" @bind="_form.Domain" placeholder="e.g. Sales, Orders, Catalog" />
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" @bind="_form.IsHomeEntity" />
                        <label class="form-check-label">Home Entity (start-up screen)</label>
                    </div>
                    @if (_editingEntity is not null && _editingEntityFields.Any())
                    {
                        <div class="mb-3">
                            <label class="form-label">Primary Field (display label)</label>
                            <select class="form-select" @bind="_form.PrimaryFieldId">
                                <option value="">(First field by sort order)</option>
                                @foreach (var f in _editingEntityFields)
                                {
                                    <option value="@f.Id">@(f.DisplayName ?? f.Name)</option>
                                }
                            </select>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveEntity">Save</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@code {
    private List<EntityDefinition>? _entities;
    private bool _showCreate;
    private EntityDefinition? _editingEntity;
    private List<FieldDefinition> _editingEntityFields = new();
    private EntityForm _form = new();
    private string? _error;
    private string _filter = "";
    private string _sortColumn = "name";
    private bool _sortAsc = true;

    private IEnumerable<EntityDefinition> FilteredEntities
    {
        get
        {
            var q = (_entities ?? new()).AsEnumerable();
            if (!string.IsNullOrWhiteSpace(_filter))
            {
                var f = _filter.Trim();
                q = q.Where(e =>
                    (e.Name?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (e.DisplayName?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (e.Domain?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false));
            }
            q = _sortColumn switch
            {
                "domain" => _sortAsc ? q.OrderBy(e => e.Domain) : q.OrderByDescending(e => e.Domain),
                _ => _sortAsc ? q.OrderBy(e => e.DisplayName ?? e.Name) : q.OrderByDescending(e => e.DisplayName ?? e.Name),
            };
            return q;
        }
    }

    private void SetSort(string column)
    {
        if (_sortColumn == column) _sortAsc = !_sortAsc;
        else { _sortColumn = column; _sortAsc = true; }
    }

    private string SortIndicator(string column) =>
        _sortColumn == column ? (_sortAsc ? "▲" : "▼") : "";

    protected override async Task OnInitializedAsync()
    {
        await LoadEntities();
    }

    private async Task LoadEntities()
    {
        _error = null;
        try { _entities = await EntityService.GetAllAsync(); }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async void EditEntity(EntityDefinition entity)
    {
        _editingEntity = await EntityService.GetByIdAsync(entity.Id);
        _editingEntityFields = _editingEntity?.Fields?.OrderBy(f => f.SortOrder).ToList() ?? new();
        _form = new EntityForm
        {
            Name = _editingEntity!.Name,
            DisplayName = _editingEntity.DisplayName ?? "",
            PluralName = _editingEntity.PluralName ?? "",
            Description = _editingEntity.Description ?? "",
            Domain = _editingEntity.Domain ?? "",
            IsHomeEntity = _editingEntity.IsHomeEntity,
            PrimaryFieldId = _editingEntity.PrimaryFieldId?.ToString() ?? ""
        };
        StateHasChanged();
    }

    private async Task SaveEntity()
    {
        _error = null;
        try
        {
            if (_editingEntity is not null)
            {
                _editingEntity.Name = _form.Name;
                _editingEntity.DisplayName = _form.DisplayName;
                _editingEntity.PluralName = _form.PluralName;
                _editingEntity.Description = _form.Description;
                _editingEntity.Domain = string.IsNullOrWhiteSpace(_form.Domain) ? null : _form.Domain.Trim();
                _editingEntity.IsHomeEntity = _form.IsHomeEntity;
                _editingEntity.PrimaryFieldId = Guid.TryParse(_form.PrimaryFieldId, out var pfId) ? pfId : null;
                await EntityService.UpdateAsync(_editingEntity.Id, _editingEntity);
            }
            else
            {
                var entity = new EntityDefinition
                {
                    Name = _form.Name,
                    DisplayName = _form.DisplayName,
                    PluralName = _form.PluralName,
                    Description = _form.Description,
                    Domain = string.IsNullOrWhiteSpace(_form.Domain) ? null : _form.Domain.Trim(),
                    IsHomeEntity = _form.IsHomeEntity
                };
                await EntityService.CreateAsync(entity);
            }
            CloseModal();
            await LoadEntities();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task DeleteEntity(Guid id)
    {
        _error = null;
        try
        {
            await EntityService.DeleteAsync(id);
            await LoadEntities();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void CloseModal()
    {
        _showCreate = false;
        _editingEntity = null;
        _form = new();
    }

    private class EntityForm
    {
        public string Name { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public string PluralName { get; set; } = "";
        public string Description { get; set; } = "";
        public string Domain { get; set; } = "";
        public bool IsHomeEntity { get; set; }
        public string PrimaryFieldId { get; set; } = "";
    }
}
